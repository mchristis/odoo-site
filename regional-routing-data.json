  "rules": {
    "BE": {
      "by": "language",
      "options": [
        {
          "lang": "nl",
          "label": "Dutch (Flanders, Dutch-speaking Brussels)",
          "unit": "BE-VLG",
          "region": "RAM-01"
        },
        {
          "lang": "fr",
          "label": "French (Wallonia, French-speaking Brussels)",
          "unit": "BE-WAL",
          "region": "RAM-02"
        }
      ],
      "default": "RAM-01",
      "note": "Brussels is routed by the customer’s language selection."
    },
    "LU": {
      "by": "language",
      "options": [
        {
          "lang": "fr",
          "label": "French",
          "unit": "LU-FR",
          "region": "RAM-02"
        },
        {
          "lang": "other",
          "label": "Other languages",
          "unit": "LU",
          "region": "CENTRAL"
        }
      ],
      "default": "RAM-02",
      "note": "French-speaking Luxembourg goes to Francophone Europe. Other languages: central team until confirmed."
    },
    "CH": {
      "by": "language",
      "options": [
        {
          "lang": "fr",
          "label": "French",
          "unit": "CH-FR",
          "region": "RAM-02"
        },
        {
          "lang": "de",
          "label": "German",
          "unit": "CH-DE",
          "region": "RAM-04"
        },
        {
          "lang": "it",
          "label": "Italian",
          "unit": "CH-IT",
          "region": "RAM-04"
        }
      ],
      "default": "RAM-04",
      "note": "Switzerland is routed by language region, not by canton boundaries."
    }
